{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xiaozhaoCoding315/Nova-Agent/thesis-templates/schema.json",
  "title": "Nova thesis template",
  "description": "一份论文格式模板。模板只编码可执行的规则，不搬运学校格式文件原文。",
  "type": "object",
  "required": ["id", "name", "description", "source", "version", "degree", "page", "margins", "headings"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
    },
    "name": { "type": "string", "minLength": 2, "maxLength": 120 },
    "description": { "type": "string", "minLength": 4 },
    "source": { "type": "string", "minLength": 4 },
    "source_url": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]+$" },
    "degree": { "enum": ["undergraduate", "master", "doctor"] },
    "is_sample": { "type": "boolean" },
    "page": {
      "type": "object",
      "required": ["size", "width_cm", "height_cm", "tolerance_cm"],
      "properties": {
        "size": { "type": "string", "minLength": 1 },
        "width_cm": { "type": "number", "exclusiveMinimum": 5, "maximum": 60 },
        "height_cm": { "type": "number", "exclusiveMinimum": 5, "maximum": 60 },
        "tolerance_cm": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "margins": {
      "type": "object",
      "required": ["top_cm", "bottom_cm", "left_cm", "right_cm", "tolerance_cm"],
      "properties": {
        "top_cm": { "type": "number", "minimum": 0.5, "maximum": 10 },
        "bottom_cm": { "type": "number", "minimum": 0.5, "maximum": 10 },
        "left_cm": { "type": "number", "minimum": 0.5, "maximum": 10 },
        "right_cm": { "type": "number", "minimum": 0.5, "maximum": 10 },
        "tolerance_cm": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "headings": {
      "type": "object",
      "required": ["max_level", "allow_skip"],
      "properties": {
        "max_level": { "type": "integer", "minimum": 1, "maximum": 6 },
        "allow_skip": { "type": "boolean" }
      }
    },
    "page_number": {
      "type": "object",
      "properties": {
        "required": { "type": "boolean" },
        "position": { "enum": ["header", "footer", "any"] }
      }
    },
    "required_sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label", "patterns"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "patterns": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "references": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "style": { "type": "string" },
        "min_entries": { "type": "integer", "minimum": 0 },
        "numbering_required": { "type": "boolean" },
        "section_patterns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "disclosure": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "intro": { "type": "string" },
        "fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
