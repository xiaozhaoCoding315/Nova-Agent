# Nova Agent — docker compose 部署模板
# 用法: cp .env.docker.example .env  →  填入 Key 与密码  →  docker compose up -d --build
# 访问 http://<服务器IP>:8000

# ---- LLM（服务端共享 Key；用户也可在设置页配置自己的 Key）----
# 可用的多厂商降级链写法：zhipu,dashscope,deepseek,anthropic
LLM_MODEL_PRIORITY=zhipu
# true = 未配置个人 Key 的用户可使用服务端 Key；
# 公开多用户部署建议设为 false，强制每个用户自带 Key。
LLM_ALLOW_SERVER_FALLBACK=true
# 智谱 GLM（默认免费模型；申请 Key：https://open.bigmodel.cn/）
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.7-flash
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen3.8-max
DEEPSEEK_API_KEY=
# Anthropic 原生（tool use + prompt caching）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_PROMPT_CACHING=true

# ---- Embedding ----
EMBEDDING_MODEL=text-embedding-v3

# ---- 登录账号（部署前务必修改）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
DEMO_USERNAME=demo
DEMO_PASSWORD=change-this-demo-password
# open = 自助注册；invite = 邀请码；closed = 仅管理员建号
REGISTRATION_MODE=open
REGISTRATION_INVITE_CODE=
MAX_USERS=50
# 每小时允许的失败登录次数（防撞库）：按来源 IP、以及「IP + 账号」各算一次；0 = 关闭
MAX_LOGIN_ATTEMPTS_PER_HOUR=20
GUEST_ENABLED=true
GUEST_TTL_HOURS=24
GUEST_HOURLY_MESSAGES=5
GUEST_DAILY_TOKENS=50000
GUEST_SANDBOX_DAILY=1
GUEST_JOB_HOURLY=2
# openssl rand -hex 32 生成；同时用于加密用户 API Key，更换后需用户重新填写
SECRET_KEY=change-me-to-a-random-32-plus-char-string
# 留空 = 按请求协议自动判断（HTTPS 下自动加 Secure）；true/false 可强制覆盖。
# 反代在 TLS 终止、内部走 http 时，自动判断**依赖 TRUSTED_PROXIES 里含反代来源**
# （后端据此采信 X-Forwarded-Proto），两项缺一 cookie 就会走明文。嫌推断麻烦
# 就直接写 true。
COOKIE_SECURE=
# 反代地址白名单（逗号分隔）。只有来自这些地址的 X-Forwarded-For/Proto 才被采信，
# 直连公网时留空即可。不设这一项时，任何人都能伪造转发头绕过注册限流与
# 「游客每网络一次」限制。
#
# 用 compose 的 caddy 服务时**填网段，不要填单个 IP**：Caddyfile 里是
# `reverse_proxy app:8000`，走的是 docker 内部网络，所以 app 看到的来源地址是
# Caddy 容器的 IP——而容器每次重建都可能换一个（172.18.0.2 → 172.18.0.3），
# 写死单个 IP 迟早失效。compose 给项目分配的 /16 网段是固定的，一次填对永久有效：
#     docker network inspect nova-agent_default \
#       --format '{{(index .IPAM.Config 0).Subnet}}'    # 例如 172.18.0.0/16
# 支持 CIDR 写法，所以可以直接填 TRUSTED_PROXIES=172.18.0.0/16。
# 填错的表现：所有请求都被算成同一个 IP，登录限流与「游客每网络一次」退化成
# 全站共享额度。
TRUSTED_PROXIES=
# 允许跨域的前端来源（逗号分隔）。前后端同源部署（Caddy 反代同一域名）时
# 留空即可；只有当你在别的域名下单独跑前端时才需要填，例如：
#     CORS_ORIGINS=https://nova.zxycoder.cn,https://zxycoder.cn
CORS_ORIGINS=

# ---- 子代理（只读并行调研）----
SUBAGENT_MAX_TASKS=4
SUBAGENT_MAX_PARALLEL=3
SUBAGENT_MAX_ROUNDS=8
SUBAGENT_TIMEOUT=300
SUBAGENT_TURN_LIMIT=8
SUBAGENT_SUMMARY_CHARS=4000

# ---- 配额（0 = 不限）----
ADMIN_HOURLY_MESSAGES=60
DEMO_HOURLY_MESSAGES=10
ADMIN_DAILY_TOKENS=0
DEMO_DAILY_TOKENS=100000
ADMIN_SANDBOX_DAILY=0
DEMO_SANDBOX_DAILY=20
# 导入/重建索引/验证/红绿任务/Builder/只读审查 每小时次数
ADMIN_JOB_HOURLY=30
DEMO_JOB_HOURLY=5

# ---- 存储（需挂载持久卷）----
USER_DATA_DIR=data/users
ATTACHMENT_MAX_MB=25
USER_STORAGE_MB=200
GUEST_STORAGE_MB=50
IMAGE_INPUT_MAX_KB=3584
IMAGE_INPUT_MAX_SIDE=8000
IMAGE_INPUT_MAX_PIXELS=40000000
IMAGE_INPUT_MAX_TOTAL_KB=10240

# ---- 沙箱 ----
# 允许管理员联网安装 Python/Node 依赖（默认关闭）
SANDBOX_ALLOW_NETWORK=false
# app 运行在容器内时，容器 /app/data 对应的宿主机路径；留空自动探测挂载
SANDBOX_HOST_DATA_DIR=
# auto/full 写命令遮蔽 .env 等密钥文件（默认开启）
SANDBOX_MASK_SECRETS=true

# ---- 联网抓取 ----
# fetch_url 工具：只读/确认模式始终拒绝；自主/完全访问模式可用
ENABLE_FETCH_URL=true
# 逗号分隔的域名 allowlist，留空表示任意公网域名（例：docs.python.org,github.com）
FETCH_URL_ALLOWED_DOMAINS=

# ---- 联网搜索 ----
# web_search 工具：只读/确认模式始终拒绝；自主/完全访问模式可用
ENABLE_WEB_SEARCH=true
# auto（默认：Bing 优先、DuckDuckGo 兜底）、bing、duckduckgo 或 brave（需 Key）
WEB_SEARCH_PROVIDER=auto
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=6
WEB_SEARCH_TIMEOUT=20

# ---- 工具 Hooks（可选）----
# pre-hook 收到 JSON stdin，退出码 2 阻断工具；post-hook 失败只记录
TOOL_PRE_HOOK=
TOOL_POST_HOOK=

# ---- MCP（外接工具，需显式 allowlist）----
MCP_ENABLED=true
MCP_CONFIG_PATH=/app/mcp_servers.json
MCP_ADMIN_ONLY=true
MCP_SERVERS_JSON=

# ---- 预览部署 ----
PREVIEW_TTL_MINUTES=120

# ---- 数据库（compose 内部使用，一般不用改）----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=nova_agent

# ---- 服务 ----
BACKEND_PORT=8000
# app 端口绑到哪个地址。默认 0.0.0.0，即 http://<IP>:8000 可直连——备案下来
# 之前只能这样访问，桌面客户端里填的服务器地址也是它。
# 启用 Caddy（--profile https）后改成 127.0.0.1：那时 :8000 就是绕过 HTTPS 的
# 明文旁路，密码和会话 cookie 会在传输中裸奔，Caddy 的证书等于白签。
APP_BIND=0.0.0.0
# ICP 备案号，会显示在登录页与左栏底部（链接到 beian.miit.gov.cn）。
# 留空则不显示，海外部署与本地运行都不用填。示例：ICP_BEIAN=粤ICP备12345678号-1
# 注意这是构建期变量：改完要重建镜像（docker compose build app），改 .env 不生效。
ICP_BEIAN=
LOG_LEVEL=INFO
AUTO_INIT_DB=true
# ---- 模型路由（共享 Key 按用途分流；BYOK 用户不受影响）----
# 规划/审查/生成用强模型，摘要/事实抽取用便宜模型；留空不启用
LLM_ROUTE_PLAN=
LLM_ROUTE_UTILITY=

# ---- 技能系统（操作员预置 SKILL.md）----
SKILLS_ENABLED=true
SKILLS_DIR=data/skills

# ---- Builder 冒烟启动（批准写入后：起容器→健康检查→回收）----
BUILDER_SMOKE_ENABLED=true

# ---- 桌面客户端安装包下载（挂载到 /downloads 页面）----
# 把安装包（desktop/release 产出的 exe/dmg/AppImage）放进宿主机 ./data/downloads 即可
DOWNLOADS_DIR=data/downloads

# ---- 邮箱（注册验证码 / 找回密码；留空 = 未启用）----
# QQ 邮箱：SMTP_HOST=smtp.qq.com, SMTP_PORT=465, SMTP_USER=你的QQ邮箱, SMTP_PASSWORD=授权码（设置-账户-开启SMTP获取）
# 阿里云邮件推送：SMTP_HOST=smtpdm.aliyun.com, SMTP_PORT=465, SMTP_USER=发信地址, SMTP_PASSWORD=SMTP密码
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=true
EMAIL_VERIFY_REQUIRED=true
