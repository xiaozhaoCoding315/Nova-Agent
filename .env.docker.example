# Nova Agent — docker compose 环境模板
# 用法: 复制为项目根目录 .env 并填入你的 API Key
#   cp .env.docker.example .env   (Windows: copy .env.docker.example .env)
#   docker compose up -d --build
# 然后访问 http://localhost:8000

# ---- LLM（至少配一个 Key，Function-Calling 推荐 DeepSeek）----
LLM_MODEL_PRIORITY=deepseek,dashscope,longcat
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
LONGCAT_API_KEY=
LONGCAT_BASE_URL=https://api.longcat.chat/openai/v1
LONGCAT_MODEL=LongCat-2.0

# ---- Embedding（知识库上传/向量检索需要）----
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v3

# ---- 数据库（compose 内自动创建，按需改密码）----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=novatech
POSTGRES_DB=novatech
NEO4J_PASSWORD=novatech123

# ---- 服务 ----
BACKEND_PORT=8000
SECRET_KEY=please-change-me
LOG_LEVEL=INFO
