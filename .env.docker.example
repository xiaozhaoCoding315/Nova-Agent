# Nova Agent — docker compose 部署模板
# 用法: cp .env.docker.example .env  →  填入 Key 与密码  →  docker compose up -d --build
# 访问 http://<服务器IP>:8000

# ---- LLM（服务端共享 Key；用户也可在设置页配置自己的 Key）----
# 可用的多厂商降级链写法：dashscope,deepseek,longcat
LLM_MODEL_PRIORITY=dashscope
# 公开多用户部署建议设为 false，强制每个用户自带 API Key
LLM_ALLOW_SERVER_FALLBACK=true
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen3.8-max
DEEPSEEK_API_KEY=
LONGCAT_API_KEY=
LONGCAT_BASE_URL=https://api.longcat.chat/openai/v1
LONGCAT_MODEL=LongCat-2.0

# ---- Embedding ----
EMBEDDING_MODEL=text-embedding-v3

# ---- 登录账号（部署前务必修改）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
DEMO_USERNAME=demo
DEMO_PASSWORD=change-this-demo-password
# openssl rand -hex 32 生成；同时用于加密用户 API Key，更换后需用户重新填写
SECRET_KEY=change-me-to-a-random-32-plus-char-string
# 启用 HTTPS 后改为 true
COOKIE_SECURE=false

# ---- 配额（0 = 不限）----
ADMIN_HOURLY_MESSAGES=60
DEMO_HOURLY_MESSAGES=10
ADMIN_DAILY_TOKENS=0
DEMO_DAILY_TOKENS=100000
ADMIN_SANDBOX_DAILY=0
DEMO_SANDBOX_DAILY=20
# 导入/重建索引/验证/红绿任务/Builder/只读审查 每小时次数
ADMIN_JOB_HOURLY=30
DEMO_JOB_HOURLY=5

# ---- 沙箱 ----
# 允许管理员联网安装 Python/Node 依赖（默认关闭）
SANDBOX_ALLOW_NETWORK=false

# ---- 工具 Hooks（可选）----
# pre-hook 收到 JSON stdin，退出码 2 阻断工具；post-hook 失败只记录
TOOL_PRE_HOOK=
TOOL_POST_HOOK=

# ---- MCP（外接工具，需显式 allowlist）----
MCP_ENABLED=true
MCP_CONFIG_PATH=/app/mcp_servers.json
MCP_ADMIN_ONLY=true
MCP_SERVERS_JSON=

# ---- 预览部署 ----
PREVIEW_TTL_MINUTES=120

# ---- 数据库（compose 内部使用，一般不用改）----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=nova_agent

# ---- 服务 ----
BACKEND_PORT=8000
LOG_LEVEL=INFO
AUTO_INIT_DB=true