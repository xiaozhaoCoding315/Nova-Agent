{
  "servers": [
    {
      "name": "filesystem",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/absolute/path/to/allowed/workspace"
      ],
      "enabled": false,
      "allow_tools": [
        "read_file",
        "list_directory",
        "search_files"
      ],
      "capabilities": {
        "read_file": ["fs.read"],
        "list_directory": ["fs.read"],
        "search_files": ["fs.read"]
      }
    },
    {
      "name": "remote-docs",
      "transport": "http",
      "url": "https://mcp.example.com/mcp",
      "headers": {"Authorization": "Bearer replace-me"},
      "enabled": false,
      "allow_tools": ["search_docs"],
      "capabilities": {
        "search_docs": ["net.fetch"]
      }
    }
  ]
}
