# Node/TS verification image: Node 20 + tsc + openapi-typescript.
# Project dependencies are installed into a per-repo volume at /workspace/node_modules.
FROM node:20-bookworm-slim

RUN sed -i 's@deb.debian.org@mirrors.aliyun.com@g' /etc/apt/sources.list.d/debian.sources \
 && apt-get update \
 && apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/*

RUN npm config set registry https://registry.npmmirror.com \
 && npm install -g typescript@5.6.3 openapi-typescript@7.13.0 \
 && corepack enable

WORKDIR /workspace
