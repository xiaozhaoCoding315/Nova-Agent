# ---- LLM（服务端共享 Key；用户也可在设置页配置自己的 Key）----
# 可用的多厂商降级链写法：dashscope,deepseek,longcat
LLM_MODEL_PRIORITY=dashscope
# true = 未配置个人 Key 的用户可使用服务端 Key；
# 公开多用户部署建议设为 false，强制每个用户自带 Key。
LLM_ALLOW_SERVER_FALLBACK=true
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen3.8-max
DEEPSEEK_API_KEY=
LONGCAT_API_KEY=
LONGCAT_BASE_URL=https://api.longcat.chat/openai/v1
LONGCAT_MODEL=LongCat-2.0

# ---- Embedding（稠密向量检索需要，走 DashScope）----
EMBEDDING_MODEL=text-embedding-v3

# ---- 数据库（本地开发可指向已有的 PG / Qdrant 实例）----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nova_agent
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ---- 登录账号（启动时自动创建/更新；改这里 = 改密码）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123
# 注册模式：open = 任何人可注册；invite = 需要邀请码；closed = 仅管理员建号
REGISTRATION_MODE=open
REGISTRATION_INVITE_CODE=
MAX_USERS=50
# 游客体验：24 小时临时账号，到期由维护任务清理
GUEST_ENABLED=true
GUEST_TTL_HOURS=24
# 同时用于加密用户保存的 API Key；更换后已保存的 Key 需要重新填写
SECRET_KEY=change-me-to-a-random-32-plus-char-string
COOKIE_SECURE=false

# ---- 配额（0 = 不限）----
ADMIN_HOURLY_MESSAGES=60
DEMO_HOURLY_MESSAGES=10
ADMIN_DAILY_TOKENS=0
DEMO_DAILY_TOKENS=100000
ADMIN_SANDBOX_DAILY=0
DEMO_SANDBOX_DAILY=20
# 导入/重建索引/验证/红绿任务/Builder/只读审查 每小时次数
ADMIN_JOB_HOURLY=30
DEMO_JOB_HOURLY=5
# 游客体验额度（24 小时临时账号）
GUEST_HOURLY_MESSAGES=5
GUEST_DAILY_TOKENS=50000
GUEST_SANDBOX_DAILY=1
GUEST_JOB_HOURLY=2

# ---- 沙箱（需要 Docker；不可用时 run_code 工具如实标记为不可用）----
SANDBOX_ENABLED=true
SANDBOX_IMAGE=nova-sandbox:latest
SANDBOX_BUILDER_IMAGE=nova-builder:latest
SANDBOX_NODE_IMAGE=nova-node:latest
# 允许管理员联网安装依赖（安全开关，默认关闭）
SANDBOX_ALLOW_NETWORK=false

# ---- 工具 Hooks（可选）----
# pre-hook 收到 JSON stdin，退出码 2 阻断工具；post-hook 失败只记录
TOOL_PRE_HOOK=
TOOL_POST_HOOK=

# ---- MCP（外接工具，需显式 allowlist）----
MCP_ENABLED=true
MCP_CONFIG_PATH=mcp_servers.json
MCP_ADMIN_ONLY=true
# 也可用 JSON 覆盖配置文件：MCP_SERVERS_JSON={"servers":[]}
MCP_SERVERS_JSON=

# ---- 预览部署 ----
# 运行中预览超过该分钟数后由维护循环自动下线（0 = 不自动回收）
PREVIEW_TTL_MINUTES=120

# ---- 运行环境 ----
APP_ENV=dev
DEBUG=false
LOG_LEVEL=INFO
LOG_DIR=logs
CORS_ORIGINS=http://localhost:5173
AUTO_INIT_DB=true