# Sandbox image for run_code — deterministic, offline at runtime.
# Build: docker build -f Dockerfile.sandbox -t nova-sandbox:latest .
# The extra packages (numpy/pytest) make "write code -> run tests -> iterate"
# flows work out of the box; the container still has no network access.
FROM python:3.12-slim

RUN sed -i 's@deb.debian.org@mirrors.aliyun.com@g' /etc/apt/sources.list.d/debian.sources \
 && apt-get update \
 && apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
        -i https://mirrors.aliyun.com/pypi/simple/ \
        numpy==2.1.3 \
        pytest==8.3.3

WORKDIR /workspace